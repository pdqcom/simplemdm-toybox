#!/bin/bash
project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")"/.. && pwd)"
use_api_console=""
use_frontend_console=""
user_id=$(id -u)
use_user="-u $user_id"
command=""
help="Usage: $(basename "${BASH_SOURCE[0]}") [ -a -f -h]
Runs a shell in a given docker container with the appropriate volume mounts
Arguments:
  -a - run api console
  -f - run frontend console
  -h - print this usage
  -v - verbose mode
  -s - skip adding user to match host uid (may be helpful on Windows or Mac)
"
while [[ $# -gt 0 ]]; do
  case $1 in
      -a)
        use_api_console='-r'
      ;;
      -f)
        use_frontend_console="-n"
      ;;
      -h)
        echo "$help"
        exit 0
      ;;
      -s)
        use_user=""
      ;;
      -v)
        set -x
      ;;
      *)
        command=$@
        break
      ;;
  esac
  shift
done

if [ -n "$use_api_console" ]; then
  echo "Starting API console" >&2
  if [ -z "$command" ]; then
    command="bash"
  fi
  docker compose run $use_user  --rm -it -v "$project_root/api":/var/www/api api $command
  exit
fi

if [ -n "$use_frontend_console" ]; then
  echo "Starting frontend console" >&2
  if [ -z "$command" ]; then
      command="sh"
    fi
  docker compose run  --rm -it -v "$project_root/frontend":/var/www/frontend frontend $command
  exit
fi

echo "Error: No console type specified" >&2;
exit 1
